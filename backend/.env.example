# ==============================================================================
# CognitiveCare Backend Environment Configuration
# ==============================================================================

# Application Meta
PROJECT_NAME="CognitiveCare Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT Authentication
# Run `openssl rand -hex 32` or python `secrets.token_hex(32)` to generate in production
SECRET_KEY="cognitive-care-dev-secret-key-change-in-production-securely"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# MySQL Database Configuration
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_mysql_root_password"
DB_NAME="cognitive_care_db"

# Fallback Database (useful for quick local testing when MySQL credentials are being configured)
USE_SQLITE_FALLBACK=False
SQLITE_DB_PATH="cognitive_care_dev.db"

# Machine Learning Artifact Paths
MODEL_PATH="app/ml/saved_models/difficulty_recommender.joblib"
DATASET_PATH="data/cognitive_game_sessions.csv"
